# Server Configuration
PORT=5000
NODE_ENV=production
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app

# Database Configuration (Choose one)
# Standard local setup
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=careercompass

# Or use connection string for PaaS (Railway, Render, Aiven)
# DATABASE_URL=mysql://root:password@host:port/database

# Security
JWT_SECRET=your_super_secret_jwt_key_here

# Third-Party APIs
# OpenAI (Required for Resume Parsing & Chat)
OPENAI_API_KEY=your_openai_api_key_here

# Google Auth (Optional, if implemented)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Email SMTP Setup (Required for Verification/Reset Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
