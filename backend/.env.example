# Server Configuration
PORT=5000
NODE_ENV=production
ALLOWED_ORIGINS=https://your-frontend-domain.onrender.com

# Frontend URL (used to build email verification/reset links)
# In production: your actual deployed frontend URL (no trailing slash)
# In local dev: http://localhost:5173
FRONTEND_URL=https://your-frontend-domain.onrender.com

# Database Configuration
# Standard local setup:
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=careercompass

# Or use a single connection string for PaaS (Railway, Render, Aiven):
# DATABASE_URL=mysql://root:password@host:port/database

# Security
JWT_SECRET=your_super_secret_jwt_key_here

# Third-Party APIs
# OpenAI (Required for Resume Parsing & Chat)
OPENAI_API_KEY=your_openai_api_key_here

# Google Auth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Email — Resend (Required for Email Verification & Password Reset)
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
